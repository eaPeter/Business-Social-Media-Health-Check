# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used to save and read submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed into /admin. Each must also exist as a
# user in Supabase Authentication. Empty = nobody can access the admin.
ADMIN_EMAILS=you@example.com
